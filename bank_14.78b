;==============================================================================
; BANK 14
;------------------------------------------------------------------------------
; The Necromancer's Fortress
;==============================================================================
        bank 14
        incgraphic gfx/tiles/palace_tile.png 160A 1 0 3 2 5
        incgraphic gfx/tiles/palace_walls.png 160A 1 0 2 3 4
        incgraphic gfx/tiles/palace_bridge.png 160A 1 0 2 3 4
        incgraphic gfx/tiles/palace_moon.png 160A 1 0 2 3 6
        incgraphic gfx/sprites/pghost0.png 160A 0 1 2 3
        incgraphic gfx/sprites/pghost1.png 160A 0 1 2 3
        incrmtfile necromancer_theme.rmta

        data palace_obj_lo
        palace_room_0_obj_lo
        palace_room_1_obj_lo
        palace_room_2_obj_lo
        palace_room_3_obj_lo
        palace_room_4_obj_lo
        palace_room_5_obj_lo
end

        data palace_obj_hi
        palace_room_0_obj_hi
        palace_room_1_obj_hi
        palace_room_2_obj_hi
        palace_room_3_obj_hi
        palace_room_4_obj_hi
        palace_room_5_obj_hi
end

load_palace
        if !first_load then goto palace_set_room
        first_load = 0
        play_music = 1

palace_start
        room_index = 29
        menu_map_Xpos = 78
        menu_map_Ypos = 160
        player_Xpos = 9*8
        player_Ypos = $90
        player_facing = DIR_UP

palace_set_room
        characterset palace_tile

palace_init
        asm
          ldx #1
          stx shadow_offset
          stx alt_torch
          dex   ; 0
          stx no_flash
          stx alt_palette
          stx pal_animation
          stx exit_room_index
          stx save_room_index
          stx player_elevation
          dex   ; $FF
          stx locked_zone
          ldx room_index
          lda palace_rooms,x
          tax
          lda palace_obj_lo,x
          sta pointer
          lda palace_obj_hi,x
          sta pointer_hi
          lda room_index
          asl
          sta menu_map_index
          clc
          adc #1
          sta menu_map_index_2
end
        stoprmt
        asm
          lda #0
          sta $0451
          sta $0453
          sta $0455
          sta $0557
end
        gosub palace_room_bank_15 bank15
        goto palace_start_music

palace_start_music
        startrmt
        if !play_music then palace_stop_rmt
        if music_playing then palace_loaded
        music_playing = 1
        playrmt necromancer_theme
palace_loaded
        return thisbank

palace_stop_rmt
        stoprmt
        asm
          lda #0
          sta $0451
          sta $0453
          sta $0455
          sta $0557
          sta music_playing
end
        goto palace_loaded

palace_pals
        if lightning_timer then goto palace_lightning
palace_sky
        asm
          lda #PAL_P_SKY
          sta P4C1
          sta P6C1
end
        goto palace_normal_pal

palace_lightning
        asm
          lda #PAL_P_LIGHTN
          sta P4C1
          sta P6C1
end

palace_normal_pal
        if alt_palette then goto palace_moon_pal
        P4C2 = getfade(PAL_P_DKWALL, black)
        P4C3 = getfade(PAL_P_LTWALL)
        P5C1 = getfade(PAL_P_BRTILE)
        P5C2 = getfade(PAL_P_DKTILE, black)
        P5C3 = getfade(PAL_P_LTTILE, black)
        goto palace_shared_pals

palace_moon_pal
        P4C2 = getfade(PAL_P_DKBRIDG, black)
        P4C3 = getfade(PAL_P_LTBRIDG)
        P5C2 = getfade(PAL_P_DKBTILE, black)
        P5C3 = getfade(PAL_P_LTBTILE)
        P6C2 = getfade(PAL_P_DKMOON)
        P6C3 = getfade(PAL_P_LTMOON)
        goto  palace_shared_pals

palace_shared_pals
        bg_color = flash_color
        incbasic shared_pals.78b
        goto palette_done

test_walkable_palace
        tile_properties_1 = palace_tile_properties[move_tile_1]
        tile_properties_2 = palace_tile_properties[move_tile_2]
        goto walkable_return

torch_tile_block_palace
        torch_tile = peekchar(current_map, peekX, peekY, 20, 14)
        if torch_tile = 52 then block_tile = 92 : goto door_tile_block_palace
        ; because this tileset was designed around RAM tilemaps, block tile is just normal tile offset by 20    
        block_tile = torch_tile + 20
door_tile_block_palace
        pokechar current_map peekX peekY 20 14 block_tile
        if object_type[index] <> TYPE_DOOR_LOCK then goto torch_tile_block_set_flag
        ; doors need to block a second tile to the right of the first
        peekX = peekX + 1
        block_tile++
        block_tile++
        pokechar current_map peekX peekY 20 14 block_tile
        goto torch_tile_block_set_flag

torch_tile_unblock_palace
        block_tile = peekchar(current_map, peekX, peekY, 20, 14)
        torch_tile = block_tile - 20
        pokechar current_map peekX peekY 20 14 torch_tile
        goto kill_torch_done

        data palace_tile_properties
        %00000011, %00000011, %00000011, %00000011, %00000011, %00000011, %00000011, %00000011
        %00000011, %00000011, %00000010, %00000010, %00000010, %00000010, %00000000
                                                                                     %00000000
        %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000001
        %00000000, %00000000, %00000001, %00000001, %00000000
end

        data palace_rooms
        00, 00, 00, 00, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
        00, 05, 04, 03, 00, 00, 00
        00, 04, 02, 01, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
end

        data palace_room_0_obj
        $00
end

        data palace_room_1_obj
        $00
end

        data palace_room_2_obj
        $00
end

        data palace_room_3_obj
        $00
end

        data palace_room_4_obj
        $00
end

        data palace_room_5_obj
        TYPE_TORCH, 8*8, $80, TYPE_TORCH, 11*8, $80
        TYPE_DOOR_LOCK, (9*8)+1, $70
        $00
end

;=========================================================
; PALACE GHOST
;---------------------------------------------------------
; Palace variant of Ghost, follows player across any ledges
;=========================================================
pghost_ai
        asm
          lda #F_PGHOST_1
          sta object_frame,x
          lda #%00000100
          sta object_flags,x
          lda animation_frame
          bne pghost_timer
          inc object_frame,x
pghost_timer
          lda object_timer,x
          bne pghost_follow
          lda #PGHOST_ANIM_TIME
          sta object_timer,x
          lda object_pal,x
          cmp #PGHOST_PAL_A
          bne pghost_set_pal_a
          lda #PGHOST_PAL_B
          sta object_pal,x
          bne pghost_follow

pghost_set_pal_a
          lda #PGHOST_PAL_A
          sta object_pal,x
pghost_follow
          dec object_timer,x
          jmp .test_follow_box
end

obj_pghost_stats
        asm
          ldx obj_index
          lda #PGHOST_HP
          sta object_hp,x
          lda #PGHOST_VEL_CAP_HI
          sta object_vel_cap_hi,x
          lda #PGHOST_VEL_CAP_LO
          sta object_vel_cap_lo,x
          lda #PGHOST_DAMAGE
          sta object_damage,x
          lda #PGHOST_DEF
          sta object_def,x
          lda #PGHOST_MDEF
          sta object_mdef,x
          lda #PGHOST_FRICTION_HI
          sta object_friction_hi,x
          lda #PGHOST_FRICTION_LO
          sta object_friction_lo,x
          lda #PGHOST_SPEED_HI
          sta object_speed_hi,x
          lda #PGHOST_SPEED_LO
          sta object_speed_lo,x
;         lda #PGHOST_FLAGS
;         sta object_flags,x
          lda #PGHOST_ELEM_ATK
          sta object_elem_atk,x
          lda #PGHOST_ELEM_DEF
          sta object_elem_def,x
end
        goto palace_160a_sprite

palace_160a_sprite
        asm
          ldx obj_index
          lda #<.plot_palace_160a
          sta object_spr_ptr_lo,x
          lda #>.plot_palace_160a
          sta object_spr_ptr_hi,x
end
        goto obj_next_stats  

plot_palace_160a
        plotsprite pghost0 sprite_pal Xposition Yposition frame
        goto plot_next