        incgraphic gfx/dragon/pdragon_top0.png 160A 0 1 2 3
        incgraphic gfx/dragon/pdragon_top1.png 160A 0 1 2 3
        incgraphic gfx/dragon/pdragon_bot0.png 160A 0 1 2 3
        incgraphic gfx/dragon/pdragon_bot1.png 160A 0 1 2 3
        incgraphic gfx/dragon/pdragon_eye.png 160A 0 3 
        incgraphic gfx/sprites/pharpy0.png 160B 0 4 9 12 6 5 8 3 2 1
        incgraphic gfx/sprites/pharpy1.png 160B 0 4 9 3 12 6 5 8 2 1
        incgraphic gfx/necro/necro_big_top0.png 160B
        incgraphic gfx/necro/necro_big_bot0.png 160B
        incrmtfile necromancer_theme.rmta

        data palace_obj_lo
        palace_room_0_obj_lo
        palace_room_1_obj_lo
        palace_room_2_obj_lo
        palace_room_3_obj_lo
        palace_room_4_obj_lo
        palace_room_5_obj_lo
end

        data palace_obj_hi
        palace_room_0_obj_hi
        palace_room_1_obj_hi
        palace_room_2_obj_hi
        palace_room_3_obj_hi
        palace_room_4_obj_hi
        palace_room_5_obj_hi
end

load_palace
        if !first_load then goto palace_set_room
        first_load = 0
        play_music = 1

palace_start
        room_index = 29
        menu_map_Xpos = 78
        menu_map_Ypos = 160
        player_Xpos = 9*8
        player_Ypos = $90
        player_facing = DIR_UP

palace_set_room
        characterset palace_tile

palace_init
        asm
          ldx #1
          stx alt_torch
          dex   ; 0
          stx no_flash
          stx alt_palette
          stx pal_animation
          stx exit_room_index
          stx save_room_index
          stx player_elevation
          dex   ; $FF
          stx locked_zone
          ldx room_index
          lda palace_rooms,x
          tax
          lda palace_obj_lo,x
          sta pointer
          lda palace_obj_hi,x
          sta pointer_hi
          lda room_index
          asl
          sta menu_map_index
          clc
          adc #1
          sta menu_map_index_2
end
        stoprmt
        asm
          lda #0
          sta $0451
          sta $0453
          sta $0455
          sta $0557
end
        gosub palace_room_bank_15 bank15
        goto palace_start_music

palace_start_music
        startrmt
        if !play_music then palace_stop_rmt
        if music_playing then palace_loaded
        music_playing = 1
        playrmt necromancer_theme
palace_loaded
        return thisbank

palace_stop_rmt
        stoprmt
        asm
          lda #0
          sta $0451
          sta $0453
          sta $0455
          sta $0557
          sta music_playing
end
        goto palace_loaded

palace_pals
        if lightning_timer then goto palace_lightning
palace_sky
        P4C1 = getfade(PAL_P_SKY, black)
        P6C1 = getfade(PAL_P_SKY, black)
        goto palace_normal_pal

palace_lightning
        asm
          lda #PAL_P_LIGHTN
          sta P4C1
          sta P6C1
end

palace_normal_pal
        if alt_palette then goto palace_moon_pal
        P4C2 = getfade(PAL_P_DKWALL, black)
        P4C3 = getfade(PAL_P_LTWALL)
        P5C1 = getfade(PAL_P_BRTILE)
        P5C2 = getfade(PAL_P_DKTILE, black)
        P5C3 = getfade(PAL_P_LTTILE, black)
        P6C1 = PAL_BLACK
        P6C2 = getfade(PAL_P_DKZOMB, black)
        P6C3 = getfade(PAL_P_LTZOMB)
        goto palace_shared_pals

palace_moon_pal
        P4C2 = getfade(PAL_P_DKBRIDG, black)
        P4C3 = getfade(PAL_P_LTBRIDG)
        P5C2 = getfade(PAL_P_DKBTILE, black)
        P5C3 = getfade(PAL_P_LTBTILE)
        P6C2 = getfade(PAL_P_DKMOON)
        P6C3 = getfade(PAL_P_LTMOON)
        P7C1 = flash_color
        P7C2 = getfade(PAL_P_LTBAT)
        P7C3 = getfade(PAL_P_DKBAT, black)
        goto  palace_shared_pals

palace_shared_pals
        bg_color = flash_color
        incbasic shared_pals.78b
        goto palette_done

test_walkable_palace
        tile_properties_1 = palace_tile_properties[move_tile_1]
        tile_properties_2 = palace_tile_properties[move_tile_2]
        goto walkable_return

torch_tile_block_palace
        torch_tile = peekchar(current_map, peekX, peekY, 20, 14)
        if torch_tile = 52 then block_tile = 92 : goto door_tile_block_palace
        ; because this tileset was designed around RAM tilemaps, block tile is just normal tile offset by 20    
        block_tile = torch_tile + 20
door_tile_block_palace
        pokechar current_map peekX peekY 20 14 block_tile
        if object_type[index] <> TYPE_DOOR_LOCK then goto torch_tile_block_set_flag
        ; doors need to block a second tile to the right of the first
        peekX = peekX + 1
        block_tile++
        block_tile++
        pokechar current_map peekX peekY 20 14 block_tile
        goto torch_tile_block_set_flag

torch_tile_unblock_palace
        block_tile = peekchar(current_map, peekX, peekY, 20, 14)
        torch_tile = block_tile - 20
        pokechar current_map peekX peekY 20 14 torch_tile
        goto kill_torch_done

        data palace_tile_properties
        %00000011, %00000011, %00000011, %00000011, %00000011, %00000011, %00000011, %00000011
        %00000011, %00000011, %00000010, %00000010, %00000010, %00000010, %00000000
                                                                                     %00000000
        %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000000, %00000001
        %00000000, %00000000, %00000001, %00000001, %00000000
end

        data palace_rooms
        00, 00, 00, 00, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
        00, 05, 04, 03, 00, 00, 00
        00, 04, 02, 01, 00, 00, 00
        00, 00, 00, 00, 00, 00, 00
end

        data palace_room_0_obj
        $00
end

        data palace_room_1_obj
        $00
end

        data palace_room_2_obj
        TYPE_PDRAGON, 240, $70
        $00
end

        data palace_room_3_obj
        TYPE_PGHOST, 15*8, $30
        $00
end

        data palace_room_4_obj
        TYPE_ZOMBIE, 15*8, $50
        $00
end

        data palace_room_5_obj
        TYPE_PBAT_SPAWNER, $E0, $E0
        TYPE_TORCH, 8*8, $80, TYPE_TORCH, 11*8, $80
        TYPE_DOOR_LOCK, (9*8)+1, $70
        $00
end

;=========================================================
; PALACE GHOST
;---------------------------------------------------------
; Palace variant of Ghost, follows player across any ledges
;=========================================================
pghost_ai
        asm
          lda #F_PGHOST_1
          sta object_frame,x
          lda #%00000100
          sta object_flags,x
          lda animation_frame
          bne pghost_timer
          inc object_frame,x
pghost_timer
          lda object_timer,x
          bne pghost_follow
          lda #PGHOST_ANIM_TIME
          sta object_timer,x
          lda object_pal,x
          cmp #PGHOST_PAL_A
          bne pghost_set_pal_a
          lda #PGHOST_PAL_B
          sta object_pal,x
          bne pghost_follow

pghost_set_pal_a
          lda #PGHOST_PAL_A
          sta object_pal,x
pghost_follow
          dec object_timer,x
          jmp .test_follow_box
end

obj_pghost_stats
        asm
          ldx obj_index
          lda #PGHOST_HP
          sta object_hp,x
          lda #PGHOST_VEL_CAP_HI
          sta object_vel_cap_hi,x
          lda #PGHOST_VEL_CAP_LO
          sta object_vel_cap_lo,x
          lda #PGHOST_DAMAGE
          sta object_damage,x
          lda #PGHOST_DEF
          sta object_def,x
          lda #PGHOST_MDEF
          sta object_mdef,x
          lda #PGHOST_FRICTION_HI
          sta object_friction_hi,x
          lda #PGHOST_FRICTION_LO
          sta object_friction_lo,x
          lda #PGHOST_SPEED_HI
          sta object_speed_hi,x
          lda #PGHOST_SPEED_LO
          sta object_speed_lo,x
;         lda #PGHOST_FLAGS
;         sta object_flags,x
          lda #PGHOST_ELEM_ATK
          sta object_elem_atk,x
          lda #PGHOST_ELEM_DEF
          sta object_elem_def,x
end
        goto palace_160a_sprite

palace_160a_sprite
        asm
          ldx obj_index
          lda #<.plot_palace_160a
          sta object_spr_ptr_lo,x
          lda #>.plot_palace_160a
          sta object_spr_ptr_hi,x
end
        goto obj_next_stats  

plot_palace_160a
        plotsprite pghost0 sprite_pal Xposition Yposition frame
        goto plot_next

plot_palace_160b
        plotsprite pharpy0 sprite_pal Xposition Yposition frame
        if !shadow_offset then goto plot_next
        frame = F_PHARPY_SH
        Yposition = Yposition + $10
        sprite_pal = 7
        goto plot_palace_160a

;==============================================================================
; PALACE BAT SPAWNER
;------------------------------------------------------------------------------
; Unsurprisingly, exists soley to spawn bat enemies
; - Bats are spawned at player's Yposition
; - player_Xpos determines if bats spawn flying left or right
; - Needs to be off screen since it does not have a sprite
;==============================================================================
pbat_spawner_ai
        asm
          lda object_timer,x    ; timer set after a bat has spawned
          beq pbatspawn          ; it's bat time!
          dec object_timer,x    ; timer--
          rts
pbatspawn 
          jsr .find_new_object  ; find an open object slot
          lda no_empty_slot     ; make sure all object slots aren't full
          beq pbatsobj           ; slot available, spawn bat object
pbatnspawn
          rts
pbatsobj  
          txa
          sta object_parent,y   ; back up the spawner's object index
          lda #TYPE_PBAT
          sta object_type,y
          lda #PBAT_HP
          sta object_hp,y
          lda #PBAT_SPEED_HI
          sta object_speed_hi,y
          lda #PBAT_VEL_CAP_HI
          sta object_vel_cap_hi,y
          lda #PBAT_SPEED_LO
          sta object_speed_lo,y
          lda #PBAT_VEL_CAP_LO
          sta object_vel_cap_lo,y
          lda #PBAT_DAMAGE
          sta object_damage,y
          lda #%00000100        ; object flying
          sta object_flags,y
          lda #0
          sta object_friction_hi,y
          sta object_friction_lo,y
          lda #PBAT_PAL
          sta object_pal,y
          lda #<.plot_palace_160a
          sta object_spr_ptr_lo,y
          lda #>.plot_palace_160a
          sta object_spr_ptr_hi,y
pbatpldir 
          jsr randomize
          bmi pbatright
pbatleft
          lda #DIR_LEFT
          sta object_Xdir,y
          lda #159
          sta object_Xpos,y
          bne pbatsetY
pbatright
          lda #DIR_RIGHT
          sta object_Xdir,y
          lda #0
          sta object_Xpos,y
pbatsetY  
          lda player_Ypos
          sta object_Ypos,y
          sta object_state,y
          lda #DIR_DOWN
          sta object_Ydir,y
pbatstime 
          lda #PBAT_SPAWN_TIME
          sta object_timer,x
          rts
end

;==============================================================================
; PALACE BAT
;------------------------------------------------------------------------------
; Flies in horizontally from off screen, attempts to collide with player
; - Bat Spawner sets X and Y starting positions
;==============================================================================
pbat_ai
        asm
; The first thing the Bat AI does is determine if it is on screen
; There is a 12-pixel grace area off both sides of the screen to allow bats
; to spawn off screen. If the bat is outside this area, it despawns
          lda object_Xpos,x
          cmp #172            ; right edge of screen + 12
          bcs pbatledge          ; determine if bat is off left edge
          bcc pbatwave           ; position is on visible screen
pbatledge cmp #243            ; left edge of screen - 12
          bcc pbatdie            ; bat isn't on screen, kill it 
pbatwave  lda object_Ydir,x     ; is the bat moving up or down?
          cmp #DIR_DOWN
          beq pbatdown
pbatup     lda object_Ypos,x     ; take the bat's current Y position
          clc
          adc #16               ; add 16 to it
          cmp object_state,x    ; compare with initial Y position
          bcs pbatvel            ; current + 16 >= initial, move bat up
          lda #DIR_DOWN         ; current + 16 < initial
          sta object_Ydir,x     ; so change direction to down
          bne pbatvel            ; bypass down comparison this frame
pbatdown   lda object_state,x    ; start with initial Y position
          clc
          adc #16               ; add 16 to it
          cmp object_Ypos,x     ; compare with current Y position
          bcs pbatvel            ; initial + 16 >= current, move bat down
          lda #DIR_UP           ; initial + 16 < current
          sta object_Ydir,x     ; so change direction to up
pbatvel    lda object_Xvel_lo,x
          clc
          adc object_speed_lo,x ; add speed to current X velocity
          sta object_Xvel_lo,x
          lda object_Xvel_hi,x
          adc object_speed_hi,x
          sta object_Xvel_hi,x
          lda object_Yvel_lo,x
          clc
          adc object_speed_lo,x ; add speed to current Y velocity
          sta object_Yvel_lo,x
          lda object_Yvel_hi,x
          adc object_speed_hi,x
          sta object_Yvel_hi,x
pbatanim   lda object_Xdir,x     ; determine bat's X direction again
          cmp #DIR_LEFT
          bne pbatanrt
pbatanlf   lda #F_PBAT_L1         ; left-facing frame 1
          jmp pbatanfr
pbatanrt   lda #F_PBAT_R1         ; right-facing frame 1
pbatanfr   sta object_frame,x    ; store it
          lda animation_frame   ; check if it needs to animate
          beq pbatdone
          inc object_frame,x    ; frame++ - frames are stored R1, R2, L1, L2
pbatdone   rts
pbatdie   lda #0
          sta object_type,x     ; kill offscreen bat
          rts
end

obj_pbat_spawner_stats
        asm
          ldx obj_index
          lda #255
          sta object_hp,x
          sta object_def,x
          sta object_mdef,x
          lda #<.plot_palace_160a
          sta object_spr_ptr_lo,x
          lda #>.plot_palace_160a
          sta object_spr_ptr_hi,x
          jmp .obj_next_stats
end

;=========================================================
; HARPY
;---------------------------------------------------------
; Decends from top of screen, swoops at player
; Maybe fires feathers as projectile attack?
;=========================================================
pharpy_ai
        asm
          lda object_timer,x
          beq pharpy_zero_Yvel
          jmp pharpy_dive_timer
pharpy_zero_Yvel
;         lda #0
;         sta object_Yvel_lo,x
;         sta object_Yvel_hi,x

; object data will fill these in as 0
;        object_pal[index] = 0
;        frame = F_HARPY_FLY_0

        ; if the player is above the harpy, the harpy flies upward
          lda player_Ypos
          sec
          sbc #32
          cmp object_Ypos,x
          bcs pharpy_dive
          lda object_Ypos,x
          cmp #$10
          bcc pharpy_dive        ; don't let the harpy go above zone 1

pharpy_fly_up
          lda #F_PHARPY_FLY_0
store_pharpy_fly
          sta object_frame,x
          lda #0
          sta object_Xvel_lo,x
          sta object_Xvel_hi,x
          lda object_Yvel_lo,x
          clc
          adc object_speed_lo,x
          sta object_Yvel_lo,x
          lda object_Yvel_hi,x
          adc object_speed_hi,x
          sta object_Yvel_hi,x
          lda #DIR_UP
          sta object_Ydir,x
end
        ; harpy moves upward 1 pixel every other frame
        if !animation_frame then pharpy_update_shadow
        temp7 = rand&3
        asm
          ldx index
          inc object_frame,x
          dec object_Ypos,x
end
        playsfx sfx_pharpyflap temp7
pharpy_update_shadow
        asm
          ldx index             ; sound code modifies x
          jmp pharpy_shadow_update

pharpy_dive
          lda object_Ypos,x
          cmp #$90
          bcs pharpy_fly_up
          lda object_type,x
pharpy_dive_frame
          lda #F_PHARPY_DIVE
store_pharpy_dive
          sta object_frame,x
          lda object_Xpos,x
          cmp player_Xpos
          bcc pharpy_dive_right
pharpy_dive_left
;         sec
;         sbc player_Xpos
;         sta temp1
          lda #DIR_LEFT
          sta object_Xdir,x
          jmp pharpy_dive_Y
pharpy_dive_right
;         lda player_Xpos
;         sec
;         sbc object_Xpos,x
;         sta temp1
          lda #DIR_RIGHT
          sta object_Xdir,x
pharpy_dive_Y
          lda #DIR_DOWN
          sta object_Ydir,x
;         lda object_Ypos,x
;         cmp player_Ypos
;         bcc pharpy_dive_Y_greater
;         sec
;         sbc player_Ypos
;         sta temp2
;         jmp pharpy_dive_arc
pharpy_dive_Y_greater
;         lda player_Ypos
;         sec
;         sbc object_Ypos,x
;         sta temp2
pharpy_dive_arc
        ; if there's no Y offset, treat this as a fly up frame
        ; lda temp2
        ; beq pharpy_dive_vel
        ; jmp pharpy_fly_up

pharpy_dive_vel
          lda object_Xvel_lo,x
          clc
          adc object_speed_lo,x
          sta object_Xvel_lo,x
          lda object_Xvel_hi,x
          adc object_speed_hi,x
          sta object_Xvel_hi,x
          lda object_Yvel_lo,x
          clc
          adc object_speed_lo,x
          sta object_Yvel_lo,x
          lda object_Yvel_hi,x
          adc object_speed_hi,x
          sta object_Yvel_hi,x

;        if temp2 > temp1 then Yvelocity = Yvelocity + move_speed
;        Yvelocity = Yvelocity + move_speed
          lda #PHARPY_DIVE_TIME
          sta object_timer,x
          ; cut off the current frame here, will resume below
          rts

pharpy_dive_timer
          dec object_timer,x

pharpy_shadow_update
          lda #0
          sta shadow_offset
          ; repurposed, hides shadow when Harpy above/below palace bridges
          lda object_Ypos,x
          cmp #$50
          bcc pharpy_done
          cmp #$78
          bcs pharpy_done
          sta shadow_offset

pharpy_done
          rts
end

obj_pharpy_stats
        asm
          ldx obj_index
          jsr load_pharpy_stats
          jmp .obj_next_stats  
load_pharpy_stats
          lda #PHARPY_HP
          sta object_hp,x
          lda #PHARPY_VEL_CAP_HI
          sta object_vel_cap_hi,x
          lda #PHARPY_VEL_CAP_LO
          sta object_vel_cap_lo,x
          lda #PHARPY_DAMAGE
          sta object_damage,x
          lda #PHARPY_DEF
          sta object_def,x
          lda #PHARPY_MDEF
          sta object_mdef,x
          lda #PHARPY_FRICTION_HI
          sta object_friction_hi,x
          lda #PHARPY_FRICTION_LO
          sta object_friction_lo,x
          lda #PHARPY_SPEED_HI
          sta object_speed_hi,x
          lda #PHARPY_SPEED_LO
          sta object_speed_lo,x
          lda #PHARPY_FLAGS
          sta object_flags,x
          lda #PHARPY_ELEM_ATK
          sta object_elem_atk,x
palace_160b_sprite
          lda #<.plot_palace_160b
          sta object_spr_ptr_lo,x
          lda #>.plot_palace_160b
          sta object_spr_ptr_hi,x
          rts
end

        data sfx_pharpyflap
        $10,$10,$00 ; version, priority, frames per chunk
        $00,$08,$06 ; first chunk of freq,channel,volume data 
        $01,$08,$05
        $02,$08,$04
        $03,$08,$03
        $04,$08,$02
        $05,$08,$01
        $06,$08,$01
        $00,$00,$00
        end

pdragon_ai
        asm
          lda object_state,x
          and #%01000000
          beq pdragon_player_check
          jmp pdragon_think
pdragon_player_check
          ; dragon walks in from left side, if player
          ; enters from left, despawn it for two harpies instead
          lda player_Xpos
          cmp #32
          bcs pdragon_walk_forward_intro
          lda #56
          sta temp1
          jmp pdragon_harpy_sub
pdragon_walk_forward_intro
          lda object_Xpos,x
          cmp #88
          bcc pdragon_set_dir_forward
          lda #%01000000
          ora object_state,x
          sta object_state,x
          jmp pdragon_think

pdragon_walk_back
pdragon_set_dir_back
          lda object_Xpos,x
;          cmp #128
;          bcc pdragon_set_dir_forward
          lda #DIR_LEFT
          bne pdragon_set_speed
pdragon_set_dir_forward
          lda object_Xpos,x
          cmp #72
          bcs pdragon_set_dir_back
          lda #DIR_RIGHT
pdragon_set_speed
          sta object_Xdir,x
          sta object_facing,x
          lda #object_speed_lo,x
          clc
          adc object_Xvel_lo,x
          sta object_Xvel_lo,x
          lda object_speed_hi,x
          adc object_Xvel_hi,x
          sta object_Xvel_hi,x

pdragon_anim
          lda #0
          sta object_frame,x
          lda animation_frame
          beq pdragon_return
          lda #1
          sta object_frame,x
end
          playsfx sfx_pdragonstomp
          shakescreen lo
          asm
pdragon_return
          rts

        ; the dragon's intro is over, now it decides how to behave
pdragon_think
          ; behavior flags
          ; %10000000 : Quake
          ; %01000000 : Moving
          lda object_flags,x
          and #%11000000
          beq pdragon_think_randomize
          ; we know the move flag is set
          jmp pdragon_move

pdragon_think_randomize
          dec object_timer,x
          bmi pdragon_think_ready
          rts
pdragon_think_ready
          jsr randomize
          bmi pdragon_move
          jmp pdragon_fire_check

pdragon_move
          dec object_timer,x
          bmi pdragon_move_set_timer
          beq pdragon_move_done
          lda player_Xpos
          cmp object_Xpos,x
          bcs pdragon_move_back
          lda object_facing,x
          cmp #DIR_RIGHT
          beq pdragon_move_back
          jmp pdragon_set_dir_forward
pdragon_move_back
          jmp pdragon_set_dir_back

pdragon_move_done
          lda #%10111111
          and object_flags,x
          sta object_flags,x
          rts

pdragon_move_set_timer
          lda #%01000000
          ora object_flags,x
          sta object_flags,x
          lda #PDRAGON_WALK_TIME
          sta object_timer,x
pdragon_move_rand
          jsr randomize
          bmi pdragon_move_set_back
          jmp pdragon_set_dir_forward
pdragon_move_set_back
          jmp pdragon_set_dir_back

pdragon_fire_check
          lda object_parent,x
          tay
          lda object_type,y
          bne pdragon_fire_return

pdragon_fire
        jsr .find_new_object
        ldy spawn_index
        beq pdragon_fire_return
        tya
        sta object_parent,x
        lda #TYPE_PDRAGON_FIRE
        sta object_type,y
        lda #255
        sta object_hp,y
        sta object_def,y
        sta object_mdef,y
        lda object_Xpos,x
        clc
        adc #29
        sta object_Xpos,y
        lda object_Ypos,x
        sta object_Ypos,y
        lda #F_PDRAGON_FIRE
        sta object_frame,y
        lda #<.plot_palace_160a
        sta object_spr_ptr_lo,y
        lda #>.plot_palace_160a
        sta object_spr_ptr_hi,y
        lda #PDRAGON_FIRE_SPEED_HI
        sta object_speed_hi,y
        sta object_vel_cap_hi,y
        lda #0
        sta object_speed_lo,y
        sta object_vel_cap_lo,y
        sta object_friction_hi,y
        sta object_friction_lo,y
        lda #PDRAGON_FIRE_DAMAGE
        sta object_damage,y
        lda #PDRAGON_FIRE_PAL
        sta object_pal,y
        lda #DIR_LEFT
        sta object_Xdir,y
        sta object_facing,y
        lda #PDRAGON_FIRE_FLAGS
        sta object_flags,y
        lda #PDRAGON_FIRE_ELEM_ATK
        sta object_elem_atk,y
        lda player_Ypos
        cmp #$78
        bcs pdragon_fire_down
        lda #0
        sta object_Ydir,y
pdragon_fire_return
        lda #PDRAGON_DELAY_FRAMES
        sta object_timer,x
        rts

pdragon_fire_down
        lda #DIR_DOWN
        sta object_Ydir,y
        lda #PDRAGON_FIRE_VERT_SPEED
        sta object_Yvel,y
        bne pdragon_fire_return

pdragon_harpy_sub
        lda #TYPE_PHARPY
        sta object_type,x
        lda #0
        sta object_Ypos,x
        lda temp1
        sta object_Xpos,x
        jsr load_pharpy_stats
        inx
        lda #104
        sta temp1
        cpx #3
        bcc pdragon_harpy_sub
        rts
end

dragon_fire_ai
        ; TODO: Timer to automatically replace poison blob with cloud
        asm
          lda #DIR_RIGHT
          sta object_Xdir,x
          sta object_facing,x
          lda #PDRAGON_FIRE_SPEED_HI
          sta object_Xvel_hi,x
          sta object_speed_hi,x
          jmp proj_move_check
end

obj_pdragon_stats
        asm
          ldx obj_index
          lda #PDRAGON_HP
          sta object_hp,x
          lda #PDRAGON_DAMAGE
          sta object_damage,x
          lda #PDRAGON_DEF
          sta object_def,x
          lda #PDRAGON_MDEF
          sta object_mdef,x
          lda #PDRAGON_SPEED_HI
          sta object_speed_hi,x
          lda #PDRAGON_VEL_CAP_HI
          sta object_friction_hi,x
          sta object_vel_cap_hi,x
          lda #PDRAGON_SPEED_LO
          sta object_speed_lo,x
          lda #0
          sta object_friction_lo,x
          sta object_vel_cap_lo,x
          lda #PDRAGON_ELEM_ATK
          sta object_elem_atk,x
          lda #PDRAGON_ELEM_DEF
          sta object_elem_def,x
          lda #<.plot_pdragon
          sta object_spr_ptr_lo,x
          lda #>.plot_pdragon
          sta object_spr_ptr_hi,x
end
        goto obj_next_stats

plot_pdragon
        Xoffset  = Xposition + 29
        Yoffset = Yposition + 16
        plotsprite pdragon_eye  2 Xoffset Yposition 0
        plotsprite pdragon_top0 7 Xposition Yposition frame
        plotsprite pdragon_bot0 7 Xposition Yoffset frame
        goto plot_next

        data sfx_pdragonstomp
        $10,$10,$00 ; version, priority, frames per chunk
        $07,$06,$05
        $0b,$06,$06
        $0b,$06,$06
        $0b,$06,$06
        $07,$06,$02
        $00,$00,$00
end

pdragon_sword_check
        Xoffset = Xposition + 12
        ; this hitbox is super generous for now
        if boxcollision (sword_Xpos, sword_Ypos, sword_width, sword_height, Xoffset, Yposition, 20, 32) then goto sword_poof
        Xoffset = Xposition + 25
        if !boxcollision (sword_Xpos, sword_Ypos, sword_width, sword_height, Xoffset, Yposition, 12, 16) then return thisbank
        goto sword_poof

pdragon_box
        temp1 = player_Xpos + 2
        temp2 = player_Ypos + 1
        temp3 = Xposition + 10
        temp4 = Yposition + 11
        if boxcollision (temp1, temp2, 9, 14, temp3, temp4, 20, 25) then goto pc_damage
pdragon_box2
        temp3 = Xposition + 24
        temp4 = Yposition + 3
        if !boxcollision (temp1, temp2, 9, 14, temp3, temp4, 14, 8) then return thisbank
        goto pc_damage

;==============================================================================
; ZOMBIE AI
;------------------------------------------------------------------------------
; Walks slowly until aligned with player, then attacks
;==============================================================================
zombie_ai
        asm
          ; check flag 6
          lda object_flags,x
          and #%01000000
          beq zombie_dir
          jmp zombie_cast_2
zombie_dir
          lda object_timer,x
          beq zombie_init_walk
          jmp zombie_walk
zombie_init_walk
          lda #0
          sta object_state,x
          lda #ZOMBIE_WALK_TIMER
          sta object_timer,x
          jsr randomize
          bpl zombie_vert

zombie_horiz
          lda #0
          sta object_Ydir,x
          lda object_Xpos,x
          cmp player_Xpos
          bcs zombie_left

zombie_right
          lda #DIR_RIGHT
          bne zombie_horiz_set

zombie_left
          lda #DIR_LEFT

zombie_horiz_set
          sta object_facing,x
          sta object_Xdir,x
          bne zombie_walk

zombie_vert
          lda #0
          sta object_Xdir,x
          lda object_Ypos,x
          cmp player_Ypos
          bcc zombie_down

zombie_up
          lda #DIR_UP
          bne zombie_vert_set

zombie_down
          lda #DIR_DOWN

zombie_vert_set
          sta object_facing,x
          sta object_Ydir,x

zombie_walk
          dec object_timer,x
          lda object_Ydir,x
          bne zombie_walk_y
        
zombie_walk_x
          jsr .test_melee
          lda melee_valid
          bne zombie_melee_x_state
          jmp zombie_walk_x_2
zombie_melee_x_state
          lda object_state,x
          beq zombie_cast_horiz
          jmp zombie_walk_x_2

zombie_walk_x_2
          lda object_Xvel_lo,x
          clc
          adc object_speed_lo,x
          sta object_Xvel_lo,x
          lda object_Xvel_hi,x
          adc object_speed_hi,x
          sta object_Xvel_hi,x
          lda #0
          sta object_Yvel_lo,x
          sta object_Yvel_hi,x
          beq zombie_walk_anim

zombie_walk_y
          jsr .test_melee
          lda melee_valid
          beq zombie_walk_y_2
          lda object_state,x
          bne zombie_walk_y_2

zombie_walk_y_2
          lda object_Yvel_lo,x
          clc
          adc object_speed_lo,x
          sta object_Yvel_lo,x
          lda object_Yvel_hi,x
          adc object_speed_hi,x
          sta object_Yvel_hi,x
          lda #0
          sta object_Xvel_lo,x
          sta object_Xvel_hi,x
zombie_walk_anim
          lda object_Xdir,x
          beq zombie_walk_anim_Y
          bne zombie_walk_anim_set
zombie_walk_anim_Y
          lda object_Ydir,x
zombie_walk_anim_set
          tay
          lda zombie_walk_frames,y
          sta object_frame,x
          lda animation_frame
          beq zombie_walk_anim_done
          inc object_frame,x
zombie_walk_anim_done
          rts

zombie_cast_horiz
          lda object_Xpos,x
          cmp player_Xpos
          bcc zombie_cast_right
zombie_cast_left
          lda #DIR_LEFT
          bne zombie_cast_horiz_set
zombie_cast_right
          lda #DIR_RIGHT
zombie_cast_horiz_set
          sta object_facing,x
          jmp zombie_cast

zombie_cast_vert
          lda object_Ypos,x
          cmp player_Ypos
          bcc zombie_cast_down
zombie_cast_up
          lda #DIR_UP
          bne zombie_cast_vert_set
zombie_cast_down
          lda #DIR_DOWN
zombie_cast_vert_set
          sta object_facing,x

        ; prep the priest/skeleton object for spawning their attacks
zombie_cast
          ldy object_parent,x
          lda object_type,y
          bne zombie_cast_return
          jsr .find_new_object
          lda no_empty_slot
          beq zombie_cast_prep
zombie_cast_return
          rts
zombie_cast_prep
          ; back up the open object slot to this object's parent variable
          tya
          sta object_parent,x
          ; back up this object to the spawned object's parent slot
          txa
          sta object_parent,y
          ; fill the slot with an off-screen darkspark so it is not overwritten
          lda #1
          sta object_type,y
          lda #$E0
          sta object_Xpos,y
          sta object_Ypos,y
          lda #<.plot_palace_160a
          sta object_spr_ptr_lo,y
          lda #>.plot_palace_160a
          sta object_spr_ptr_hi,y
          lda object_flags,x
          ora #%01000000
          sta object_flags,x

          ; y is reloaded from spawn index later
          lda object_facing,x
          tay
          lda object_type,x
          lda zombie_cast_frames,y
zombie_cast_store_frame
          sta object_frame,x
          lda #0
          sta object_Xvel_hi,x
          sta object_Xvel_lo,x
          sta object_Yvel_hi,x
          sta object_Yvel_lo,x
          lda #ZOMBIE_CAST_FRAMES
          sta object_timer,x

zombie_cast_2
          lda object_flags,x
          bpl zombie_sword_pos
zombie_sword_rts
        rts
zombie_sword_pos
        jsr .position_sword
        ; get the backed up object slot for sword
        lda object_parent,x
        tay
        lda #TYPE_ZOMBFIST
        sta object_type,y
        lda #0
        sta object_flags,y
        sta object_vel_cap_hi,y 
        sta object_speed_hi,y
        sta object_vel_cap_lo,y
        sta object_speed_lo,y
        lda #ZOMBFIST_DAMAGE
        sta object_damage,y
        sta object_hp,y ; dummy stat but needed for damage code
        lda #255
        sta object_def,y
        ; position and frame variables set by position_sword
        lda Xposition
        sta object_Xpos,y
        lda Yposition
        sta object_Ypos,y
        lda frame
        sta object_frame,y
        lda object_facing,x
        sta object_facing,y
        lda #1
        sta object_timer,y
        lda #ZOMBFIST_PAL
        sta object_pal,y
        lda #<.plot_palace_160a
        sta object_spr_ptr_lo,y
        lda #>.plot_palace_160a
        sta object_spr_ptr_hi,y
        lda object_flags,x
        ora #%10000000
        sta object_flags,x
        rts
end

        data zombie_walk_frames
        0, F_ZOMBIE_UP_1, F_ZOMBIE_DOWN_1, F_ZOMBIE_LEFT_1, F_ZOMBIE_RIGHT_1
end
        data zombie_cast_frames
        0, F_ZOMBIE_CAST_UP, F_ZOMBIE_CAST_DOWN, F_ZOMBIE_CAST_LEFT, F_ZOMBIE_CAST_RIGHT
end

;==============================================================================
; ZOMBFIST AI
;------------------------------------------------------------------------------
; Exists for ATTACK_FRAMES duration, then kills itself
;==============================================================================
zombfist_ai
        asm
          lda object_parent,x
          tay
          lda object_type,y     ; if Zombie has died
          beq zf_kill           ; remove fist instantly
          dec object_timer,x
          lda object_flags,x
          bmi zf_retract_2
          lda object_timer,x
          beq zombfist_flags
          rts
zombfist_flags
          lda object_flags,x
          and #%01000000
          bne zf_retract
          lda #ATTACK_FRAMES
          sta object_timer,x
          lda object_flags,x
          ora #%01000000
          sta object_flags,x
          rts

zf_retract
          lda #RETRACT_FRAMES
          sta object_timer,x
          lda object_flags,x
          ora #%10000000
          sta object_flags,x

zf_retract_2
          lda object_timer,x
          beq zf_kill
          rts

zf_kill
          lda #0
        ; unset flags 6 and 7 on parent zombie
          sta object_flags,y
          sta object_type,x
        ; use state as an extra flag to force zombie to walk after melee
          lda #1
          sta object_state,y
          rts
end

obj_zombie_stats
        asm
          ldx obj_index
          lda #ZOMBIE_HP
          sta object_hp,x
          lda #ZOMBIE_VEL_CAP_HI
          sta object_vel_cap_hi,x
          lda #ZOMBIE_VEL_CAP_LO
          sta object_vel_cap_lo,x
          lda #ZOMBIE_DAMAGE
          sta object_damage,x
          lda #ZOMBIE_DEF
          sta object_def,x
          lda #ZOMBIE_MDEF
          sta object_mdef,x
          lda #ZOMBIE_FRICTION_HI
          sta object_friction_hi,x
          lda #ZOMBIE_FRICTION_LO
          sta object_friction_lo,x
          lda #ZOMBIE_SPEED_HI
          sta object_speed_hi,x
          lda #ZOMBIE_SPEED_LO
          sta object_speed_lo,x
          lda #ZOMBIE_FLAGS
          sta object_flags,x
          lda #ZOMBIE_ELEM_ATK
          sta object_elem_atk,x
          lda #ZOMBIE_ELEM_DEF
          sta object_elem_def,x
          lda #<.plot_palace_160a
          sta object_spr_ptr_lo,x
          lda #>.plot_palace_160a
          sta object_spr_ptr_hi,x
          lda #ZOMBIE_PAL
          sta object_pal,x
          lda #F_ZOMBIE_DOWN_1
          sta object_frame,x
end
        goto obj_next_stats