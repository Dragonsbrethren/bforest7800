plot_forest_room_20
        memcpy map12 forest_room_20 240
        plotmapfile tiled/forest_room_20.tmx map12 0 1 20 12
        asm
          lda #1
          sta alt_palette
          sta alt_torch
end
        exit_tileset = T_FOREST
        exit_Xpos = 9*8
        exit_Ypos = $B0
        exit_room_index = F_FOREST_ARMOR_EXIT_I
