plot_forest_room_21
        ; inn room toggles on its normal map square
        menu_map_room[76] = ROOML_UDL
        menu_map_room[77] = ROOMR_UDR
        memcpy map12 forest_room_21 280
        plotmapfile tiled/forest_room_21.tmx map12 0 1 20 12
        asm
