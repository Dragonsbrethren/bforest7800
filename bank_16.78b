end

forest_room_bank_16
        asm
          lda forest_map_b16_lo,x
          sta jump1
          lda forest_map_b16_hi,x
          sta jump2
          jmp (jump1)
end

plot_forest_room_0
plot_forest_room_1
        menu_map_room[menu_map_index] = ROOML_UL
        menu_map_room[menu_map_index_2] = ROOMR_UR
        memcpy map12 forest_room_1 240
        plotmapfile tiled/forest_room_1.tmx map12 0 1 20 12
        return otherbank

